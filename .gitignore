### Local network & environment workarounds (do NOT commit) ###
# init.gradle hardcodes an absolute local-repo path and a 127.0.0.1:18080 proxy.
# The proxy/download scripts are only useful on machines that cannot reach
# maven.neoforged.net directly. Keep them local; CI and normal builds do not need them.
init.gradle
download_deps.ps1
neoforge_proxy.ps1
proxy.ps1
